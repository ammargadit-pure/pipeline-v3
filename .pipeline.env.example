export CMD_TEST="ctest --test-dir build --output-on-failure"
export CMD_TYPECHECK="cmake --build build --target all 2>&1"
export CMD_COVERAGE="ctest --test-dir build --output-on-failure && gcovr --root . --print-summary"
export CMD_DEV="./build/ota_agent"
export CMD_INSTALL="cmake -B build -DCMAKE_BUILD_TYPE=Debug && cmake --build build"
export DEPS_DIR="build"
export TEST_DIR="tests"
export UNIT_TEST_DIR="tests/unit"
export TEST_FILE_PATTERN="test_*.cpp"
export TEST_BLOCK_PATTERN="TEST_F\|TEST(\|TEST_P("
export ASSERT_PATTERN="EXPECT_\|ASSERT_"
export MOCK_PATTERNS="MOCK_METHOD\|NiceMock\|StrictMock\|MockFunction"
export SKIP_PATTERNS="GTEST_SKIP\|DISABLED_"
export ITER_TIMEOUT="900"
